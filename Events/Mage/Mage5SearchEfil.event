ChapterEvents(Mage5SearchEfilEvents,ThisChapter)

//Label ThisChapter
ThisChapter:
POIN TurnBasedEvents
POIN CharacterBasedEvents
POIN LocationBasedEvents
POIN MiscBasedEvents
POIN EndMainPointer EndMainPointer EndMainPointer
POIN EndMainPointer
POIN TrapData TrapData
POIN Units Units
POIN $0 $0 $0 $0 $0 $0
POIN BeginningScene EndingScene
//LabelEnd

//Label TurnBasedEvents
TurnBasedEvents:
TurnEventEnemy(0x0,Turn2,2)
TurnEventEnemy(0x0,Turn4,4)
TurnEventEnemy(0x0,Turn6,6)
TurnEventEnemy(0x0,Turn8,8)
END_MAIN

//Label CharacterBasedEvents
ALIGN 32
CharacterBasedEvents:
CharacterEventBothWays(0x10,TTactKendrick,0x00,Kendrick)
CharacterEventBothWays(0x11,TZahevaAjax,Zaheva,Ajax)
CharacterEventBothWays(0x12,TXenaTact,Xena,0x00)
END_MAIN

//Label LocationBasedEvents
LocationBasedEvents:
Escape(0x00,EndingScene,27,2)
Escape(0x00,EndingScene,27,3)
Escape(0x00,EndingScene,27,4)
Escape(0x00,EndingScene,27,5)
Escape(0x00,EndingScene,27,6)
Escape(0x00,EndingScene,27,7)
Escape(0x00,EndingScene,27,8)
Escape(0x00,EndingScene,27,9)
Escape(0x00,EndingScene,27,10)
Escape(0x00,EndingScene,27,11)
Escape(0x00,EndingScene,27,12)
END_MAIN

//Label MiscBasedEvents
MiscBasedEvents:
CauseGameOverIfLordDies
AREA 0x13 AngelicRobePickup [8,11] [10,13]
AREA 0x14 BodyRingPickup [17,1] [19,3]
END_MAIN

//Label TrapData
TrapData:
ENDTRAP
ALIGN 4

//Label Units
Units:
UNIT PlayerMMage 0x00 0x00 Level(1,Ally,True) [1,8] 0x00 0x00 0x00 0x00 [0] NoAI
UNIT Xena 0x00 0x00 Level(1,Ally,True) [0,8] 0x00 0x00 0x00 0x00 [0] NoAI
UNIT Kendrick 0x00 0x00 Level(1,Ally,True) [1,9] 0x00 0x00 0x00 0x00 [0] NoAI
UNIT Zaheva 0x00 0x00 Level(1,Ally,True) [0,7] 0x00 0x00 0x00 0x00 [0] NoAI
UNIT Ajax 0x00 0x00 Level(1,Ally,True) [1,7] 0x00 0x00 0x00 0x00 [0] NoAI
EndUnit

//Label BeginingScene
BeginningScene:
CAM1 [4,7]
LOAD3 0x1 PlayerLoading1
LOAD2 0x1 ChapterFriends
ENUN
MUSC Dry_Trail
SetBackground(0x30) // The deep desert.
Text(Mage5SearchEfilStartingText)
EndConvo
STAL 0x10
MUSC Darker
LOAD1 0x1 Wanderers
ENUN
STAL 0x20
Text(Mage5SearchEfilStormText)
STAL 0x10
GotoPrepScreen

//Label EndingScene
EndingScene: // Tact reached the eastern edge of the desert.
FADI 0x5
CLEE 0x0
CALL RevealParty
MUSC Lights_in_the_Dark
SetBackground(0x29) // Outside the temple of Kilthel.
Text(Mage5SearchEfilEndingText)
MoveToChapter(MageSearchEfil6)
NoFade
ENDA

RevealParty:
REVEAL 0x00
REVEAL Xena
REVEAL Kendrick
REVEAL Zaheva
REVEAL Ajax
ENDA

//Label Turn events
Turn2:
CamON
LOAD1 0x1 Turn2Units
ENUN
CamOFF
NoFade
EndA2

Turn4:
CamON
LOAD1 0x1 Turn4Units
ENUN
CamOFF
NoFade
EndA2

Turn6:
CamON
LOAD1 0x1 Turn6Units
ENUN
CamOFF
NoFade
EndA2

Turn8:
CamON
LOAD1 0x1 Turn8Units
ENUN
CamOFF
NoFade
ENDA

//Label Character events
TTactKendrick:
MUSI
Text(Mage5SearchEfilTactKendrickText)
MUNO
NoFade
EndA2

TZahevaAjax:
MUSI
Text(Mage5SearchEfilZahevaAjaxText)
MUNO
NoFade
EndA2

TXenaTact:
MUSI
Text(Mage5SearchEfilXenaTactText)
MUNO
NoFade
ENDA

//Label Sand pickups
AngelicRobePickup:
SandPickup(0x13,AngelicRobe)
NoFade
EndA2

BodyRingPickup:
SandPickup(0x14,BodyRing)
NoFade
ENDA

