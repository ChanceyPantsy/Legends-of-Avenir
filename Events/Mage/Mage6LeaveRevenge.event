ChapterEvents(Mage6LeaveRevengeEvents,ThisChapter)

//Label ThisChapter
ThisChapter:
POIN TurnBasedEvents
POIN CharacterBasedEvents
POIN LocationBasedEvents
POIN MiscBasedEvents
POIN EndMainPointer EndMainPointer EndMainPointer
POIN EndMainPointer
POIN TrapData TrapData
POIN Units Units
POIN $0 $0 $0 $0 $0 $0
POIN BeginningScene EndingScene
//LabelEnd

//Label TurnBasedEvents
TurnBasedEvents:
TurnEventPlayer(0x0,AryaThinks,2)
TurnEventEnemy(0x0,Turn4,4)
TurnEventEnemy(0x0,Turn7,7)
END_MAIN

//Label CharacterBasedEvents
ALIGN 32
CharacterBasedEvents:
CharacterEvent(0x10,TZahevaArya,Zaheva,Arya)
CharacterEvent(0x10,TTactArya,0x00,Arya)
END_MAIN

//Label LocationBasedEvents
LocationBasedEvents:
Chest(Elixir,16,8)
Chest(Thoron,18,8)
Chest(Luna,14,19)
Chest(SilverSword,16,19)
Chest(Physic,18,19)
END_MAIN

//Label MiscBasedEvents
MiscBasedEvents:
DefeatBoss(EndingScene)
CauseGameOverIfLordDies
END_MAIN

//Label TrapData
TrapData:
ENDTRAP
ALIGN 4

