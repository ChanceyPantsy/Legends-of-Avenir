//Label BeginingScene
BeginningScene:
MUSC Darker
SetBackground(0x17) // Mistlain's old passages.
Text(Mage6LeaveRevengeStartingText)
EndConvo
STAL 0x10
CAM1 [2,15]
LOAD3 0x1 PlayerLoading1
LOAD2 0x1 ChapterFriends
ENUN
LOAD1 0x1 LabGuard
ENUN
STAL 0x10
CAM1 [5,10]
STAL 0x10
Text(Mage6LeaveRevengeCellsText)
STAL 0x10
CAM1 [17,2]
STAL 0x10
MUSC Tension
Text(Mage6LeaveRevengeDunlasText)
STAL 0x10
CAM1 [2,15]
Text(Mage6LeaveRevengeObjectiveText)
STAL 0x10
GotoPrepScreen

//Label EndingScene
EndingScene:
FADI 0x5
CLEE 0x0
MUSC Treasured_Memories
SetBackground(0x17) // The empty cells.
Text(Mage6LeaveRevengeEndingText)
MoveToChapter(MageLeaveRevenge7)
NoFade
ENDA

