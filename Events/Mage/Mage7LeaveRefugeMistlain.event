ChapterEvents(Mage7LeaveRefugeMistlainEvents,ThisChapter)

//Label ThisChapter
ThisChapter:
POIN TurnBasedEvents
POIN CharacterBasedEvents
POIN LocationBasedEvents
POIN MiscBasedEvents
POIN EndMainPointer EndMainPointer EndMainPointer
POIN EndMainPointer
POIN TrapData TrapData
POIN Units Units
POIN $0 $0 $0 $0 $0 $0
POIN BeginningScene EndingScene
//LabelEnd

//Label TurnBasedEvents
TurnBasedEvents:
TurnEventEnemy(0x0,UzkalisArrives,2)
TurnEventEnemy(0x0,Turn4,4)
TurnEventEnemy(0x0,Turn6,6)
END_MAIN

//Label CharacterBasedEvents
ALIGN 32
CharacterBasedEvents:
CharacterEvent(0x10,TTactMistlain,0x00,Mistlain)
CharacterEvent(0x11,TXenaMistlain,Xena,Mistlain)
END_MAIN

//Label LocationBasedEvents
LocationBasedEvents:
Escape(0x00,EndingScene,14,24) // Out of the city across the south bridge. Mistlain must escape too for the good ending.
Escape(0x00,EndingScene,15,24)
Escape(0x00,EndingScene,16,24)
Escape(0x00,EndingScene,17,24)
END_MAIN

//Label MiscBasedEvents
MiscBasedEvents:
CauseGameOverIfLordDies
END_MAIN

//Label TrapData
TrapData:
ENDTRAP
ALIGN 4

//Label Units
Units:
EndUnit

//Label BeginingScene
BeginningScene:
ENUT 0x12 // Prevents the good ending Tact death quote.
ENUT 0x13 // Prevents the bad ending Tact death quote.
CAM1 [5,8]
LOAD3 0x1 PlayerLoading1
LOAD2 0x1 ChapterFriends
ENUN
LOAD1 0x1 CityWatch
ENUN
MUSC Darker
Text(Mage7LeaveRefugeMistlainStartingText)
STAL 0x10
CAM1 [10,10]
STAL 0x10
SOUN 0x2D0
TILECHANGE 1 // Mistlain blasts a hole in the old wall.
STAL 0x20
CAM1 [12,20]
STAL 0x20
CAM1 [5,8]
Text(Mage7LeaveRefugeMistlainObjectiveText)
STAL 0x10
MUSC Lights_in_the_Dark
NoFade
ENDA

//Label EndingScene
EndingScene:
CHECK_DEPLOYED Mistlain // Escaped units are no longer deployed.
BEQ 0x2 0x0 0xC
	ENUT 0x15 // He stayed behind to hold the bridge.
	REMU Mistlain
LABEL 0x2
FADI 0x5
REVEAL 0x00
REVEAL Xena
REVEAL Mistlain
REVEAL Zaheva
REVEAL Ajax
REVEAL Clara
REVEAL Kendrick
CLEA 0x0
CLEE 0x0
CLEN 0x0
ASMC RefreshAll|1
ASMC PrepForEnd|1
CHECK_EVENTID 0x14 // Mistlain died.
BNE 0x0 0x0 0xC
CHECK_EVENTID 0x15 // Mistlain stayed behind.
BNE 0x0 0x0 0xC
	// Mistlain made it out alive. Good ending.
	ENUF 0x12 // Enable Tact's good ending death quote.
	SVAL 0xB Coords(15,22)
	LOMA MageLeaveRefugeMistlain7
	TILECHANGE 1
	LOAD3 0x1 EndingTact
	LOAD2 0x1 EndingFriendsGood
	ENUN
	MUSC Treasured_Memories
	FADU 0x5
	STAL 0x20
	Text(Mage7LeaveRefugeMistlainGoodEndingText)
	STAL 0x10
	FadeOutMusic
	STAL 0x20
	MUSC The_Guardian_Spirit
	WarpIn(17,22,LoadNarrator)
	STAL 0x20
	Text(Mage7LeaveRefugeMistlainGoodEndingNarratorText)
	STAL 0x08
	MOVE 0x00 Narrator [16,22]
	ENUN
	StartBattle
	NormalDamage(1,24)
	MissedAttack(0,0)
	CriticalHit(1,60)
	EndAttack
	SetBattleNumbers(21,8,0,91,24,20)
	FIG1 0x00 Narrator 0x00
	KillUnit(0x00)
	DISA 0x00
	GOTO 0x1
LABEL 0x0
	// Mistlain held the bridge. Bad ending.
	ENUF 0x13 // Enable Tact's bad ending death quote.
	SVAL 0xB Coords(15,22)
	LOMA MageLeaveRefugeMistlain7
	TILECHANGE 1
	LOAD3 0x1 EndingTact
	LOAD2 0x1 EndingFriends
	ENUN
	MUSC All_Is_Lost
	FADU 0x5
	STAL 0x20
	Text(Mage7LeaveRefugeMistlainBadEndingText)
	STAL 0x10
	FadeOutMusic
	STAL 0x20
	MUSC The_Guardian_Spirit
	WarpIn(17,22,LoadNarrator)
	STAL 0x20
	Text(Mage7LeaveRefugeMistlainBadEndingNarratorText)
	STAL 0x08
	MOVE 0x00 Narrator [16,22]
	ENUN
	StartBattle
	NormalDamage(1,30)
	NormalDamage(1,30)
	EndAttack
	SetBattleNumbers(21,8,0,87,30,18)
	FIG1 0x00 Narrator 0x00
	KillUnit(0x00)
	DISA 0x00
	STAL 0x20
LABEL 0x1
ENUT 0xDC // This life ended in the Mage route's Flame ending. (True ending tracker.)
CALL MageRouteCleanup
MoveToChapter(PrologueChapter)
ENDA

//Label Turn events
UzkalisArrives:
CAM1 [3,1]
LOAD1 0x1 UzkalisSquad
ENUN
STAL 0x10
MUSC Cataclysm
Text(Mage7LeaveRefugeMistlainUzkalisText)
NoFade
EndA2

Turn4:
CamON
LOAD1 0x1 Turn4Units
ENUN
CamOFF
NoFade
EndA2

Turn6:
CamON
LOAD1 0x1 Turn6Units
ENUN
CamOFF
NoFade
ENDA

//Label Character events
TTactMistlain:
MUSI
Text(Mage7LeaveRefugeMistlainTactMistlainText)
MUNO
NoFade
EndA2

TXenaMistlain:
MUSI
Text(Mage7LeaveRefugeMistlainXenaMistlainText)
MUNO
NoFade
ENDA

