ChapterEvents(Mage7LeaveRevengeEvents,ThisChapter)

//Label ThisChapter
ThisChapter:
POIN TurnBasedEvents
POIN CharacterBasedEvents
POIN LocationBasedEvents
POIN MiscBasedEvents
POIN EndMainPointer EndMainPointer EndMainPointer
POIN EndMainPointer
POIN TrapData TrapData
POIN Units Units
POIN $0 $0 $0 $0 $0 $0
POIN BeginningScene EndingScene
//LabelEnd

//Label TurnBasedEvents
TurnBasedEvents:
TurnEventEnemy(0x0,PurgeC,5) // Clint floods one cell block at a time, unless its release has been pulled.
TurnEventEnemy(0x0,PurgeA,8)
TurnEventEnemy(0x0,PurgeB,11)
TurnEventEnemy(0x0,Turn4,4)
TurnEventEnemy(0x0,Turn7,7)
END_MAIN

//Label CharacterBasedEvents
ALIGN 32
CharacterBasedEvents:
END_MAIN

//Label LocationBasedEvents
LocationBasedEvents:
House(0x13,LeverC,19,15) // Release for the block nearest the stairs.
House(0x14,LeverA,4,10) // Release for the island block.
House(0x15,LeverB,12,23) // Release for the block beside Clint's chair.
Chest(Elixir,11,20)
Chest(Bolting,13,20)
END_MAIN

//Label MiscBasedEvents
MiscBasedEvents:
DefeatBoss(EndingScene)
CauseGameOverIfLordDies
END_MAIN

//Label TrapData
TrapData:
ENDTRAP
ALIGN 4

//Label Units
Units:
UNIT PlayerMMage 0x00 0x00 Level(1,Ally,True) [16,2] 0x00 0x00 0x00 0x00 [0] NoAI
UNIT Xena 0x00 0x00 Level(1,Ally,True) [15,2] 0x00 0x00 0x00 0x00 [0] NoAI
UNIT Zaheva 0x00 0x00 Level(1,Ally,True) [17,2] 0x00 0x00 0x00 0x00 [0] NoAI
UNIT Ajax 0x00 0x00 Level(1,Ally,True) [16,1] 0x00 0x00 0x00 0x00 [0] NoAI
UNIT Clara 0x00 0x00 Level(1,Ally,True) [16,3] 0x00 0x00 0x00 0x00 [0] NoAI
UNIT Val 0x00 0x00 Level(1,Ally,True) [13,2] 0x00 0x00 0x00 0x00 [0] NoAI
UNIT Helmer 0x00 0x00 Level(1,Ally,True) [19,2] 0x00 0x00 0x00 0x00 [0] NoAI
UNIT Arya 0x00 0x00 Level(1,Ally,True) [15,3] 0x00 0x00 0x00 0x00 [0] NoAI
EndUnit

//Label BeginingScene
BeginningScene:
ENUT 0x1A // Prevents the good ending Tact death quote.
ENUT 0x1B // Prevents the bad ending Tact death quote.
CAM1 [16,2]
LOAD3 0x1 PlayerLoading1
LOAD2 0x1 ChapterFriends
ENUN
MUSC Darker
Text(Mage7LeaveRevengeStartingText)
STAL 0x10
LOAD1 0x1 LabGuard
ENUN
STAL 0x10
CAM1 [4,19]
STAL 0x20
MUSC Dark_Clouds_Gather
Text(Mage7LeaveRevengeClintText)
STAL 0x10
CAM1 [17,14]
STAL 0x20
CAM1 [4,11]
STAL 0x20
CAM1 [12,21]
STAL 0x20
CAM1 [16,2]
Text(Mage7LeaveRevengeObjectiveText)
STAL 0x10
GotoPrepScreen

//Label EndingScene
EndingScene:
FADI 0x5
CLEA 0x0
CLEE 0x0
CLEN 0x0
ASMC RefreshAll|1
ASMC PrepForEnd|1
CHECK_EVENTID 0x16
BNE 0x0 0x0 0xC
CHECK_EVENTID 0x17
BNE 0x0 0x0 0xC
CHECK_EVENTID 0x18
BNE 0x0 0x0 0xC
	// No block was flooded. Every prisoner walks out. Good ending.
	ENUF 0x1A // Enable Tact's good ending death quote.
	SVAL 0xB Coords(4,20)
	LOMA MageLeaveRevenge7
	TILECHANGE 2
	LOAD3 0x1 EndingTact
	LOAD2 0x1 EndingFriends
	ENUN
	MUSC Treasured_Memories
	FADU 0x5
	STAL 0x20
	Text(Mage7LeaveRevengeGoodEndingText)
	STAL 0x10
	FadeOutMusic
	STAL 0x20
	MUSC The_Guardian_Spirit
	WarpIn(6,21,LoadNarrator)
	STAL 0x20
	Text(Mage7LeaveRevengeGoodEndingNarratorText)
	STAL 0x08
	MOVE 0x00 Narrator [5,21]
	ENUN
	StartBattle
	NormalDamage(1,24)
	MissedAttack(0,0)
	CriticalHit(1,60)
	EndAttack
	SetBattleNumbers(21,8,0,91,24,20)
	FIG1 0x00 Narrator 0x00
	KillUnit(0x00)
	DISA 0x00
	GOTO 0x1
LABEL 0x0
	// At least one block was flooded. Revenge, and nothing after it. Bad ending.
	ENUF 0x1B // Enable Tact's bad ending death quote.
	SVAL 0xB Coords(4,20)
	LOMA MageLeaveRevenge7
	LOAD3 0x1 EndingTact
	LOAD2 0x1 EndingFriends
	ENUN
	MUSC All_Is_Lost
	FADU 0x5
	STAL 0x20
	Text(Mage7LeaveRevengeBadEndingText)
	STAL 0x10
	FadeOutMusic
	STAL 0x20
	MUSC The_Guardian_Spirit
	WarpIn(6,21,LoadNarrator)
	STAL 0x20
	Text(Mage7LeaveRevengeBadEndingNarratorText)
	STAL 0x08
	MOVE 0x00 Narrator [5,21]
	ENUN
	StartBattle
	NormalDamage(1,30)
	NormalDamage(1,30)
	EndAttack
	SetBattleNumbers(21,8,0,87,30,18)
	FIG1 0x00 Narrator 0x00
	KillUnit(0x00)
	DISA 0x00
	STAL 0x20
LABEL 0x1
ENUT 0xDA // This life ended in the Mage route's Revenge ending. (True ending tracker.)
CALL MageRouteCleanup
MoveToChapter(PrologueChapter)
ENDA

//Label Turn events
Turn4:
CamON
LOAD1 0x1 Turn4Units
ENUN
CamOFF
NoFade
EndA2

Turn7:
CamON
LOAD1 0x1 Turn7Units
ENUN
CamOFF
NoFade
EndA2

PurgeC:
CHECK_EVENTID 0x13
BNE 0x0 0x0 0xC
	CAM1 [17,14]
	STAL 0x10
	ENUT 0x16 // Block C was flooded.
	SOUN 0x2D0
	Text(Mage7LeaveRevengePurgeText)
	GOTO 0x1
LABEL 0x0
	CAM1 [4,19]
	Text(Mage7LeaveRevengeSealHoldsText)
LABEL 0x1
NoFade
EndA2

PurgeA:
CHECK_EVENTID 0x14
BNE 0x0 0x0 0xC
	CAM1 [4,11]
	STAL 0x10
	ENUT 0x17 // Block A was flooded.
	SOUN 0x2D0
	Text(Mage7LeaveRevengePurgeText)
	GOTO 0x1
LABEL 0x0
	CAM1 [4,19]
	Text(Mage7LeaveRevengeSealHoldsText)
LABEL 0x1
NoFade
EndA2

PurgeB:
CHECK_EVENTID 0x15
BNE 0x0 0x0 0xC
	CAM1 [12,21]
	STAL 0x10
	ENUT 0x18 // Block B was flooded.
	SOUN 0x2D0
	Text(Mage7LeaveRevengePurgeText)
	GOTO 0x1
LABEL 0x0
	CAM1 [4,19]
	Text(Mage7LeaveRevengeSealHoldsText)
LABEL 0x1
NoFade
ENDA

//Label Location events
LeverC:
Text(Mage7LeaveRevengeLeverCText)
SOUN 0x00BD
NoFade
EndA2

LeverA:
Text(Mage7LeaveRevengeLeverAText)
SOUN 0x00BD
NoFade
EndA2

LeverB:
Text(Mage7LeaveRevengeLeverBText)
SOUN 0x00BD
TILECHANGE 2 // The block's door opens.
NoFade
ENDA

