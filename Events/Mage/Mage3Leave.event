ChapterEvents(Mage3LeaveEvents,ThisChapter)

//Label ThisChapter
ThisChapter:
POIN TurnBasedEvents
POIN CharacterBasedEvents
POIN LocationBasedEvents
POIN MiscBasedEvents
POIN EndMainPointer EndMainPointer EndMainPointer
POIN EndMainPointer
POIN TrapData TrapData
POIN Units Units
POIN $0 $0 $0 $0 $0 $0
POIN BeginningScene EndingScene
//LabelEnd

//Label TurnBasedEvents
TurnBasedEvents:
TurnEventPlayer(0x0,ClaraArrives,2)
TurnEventEnemy(0x0,Pursuers,3)
TurnEventEnemy(0x0,Turn5,5)
END_MAIN

//Label CharacterBasedEvents
ALIGN 32
CharacterBasedEvents:
CharacterEvent(0x10,TXenaClara,Xena,Clara)
CharacterEvent(0x10,TTactClara,0x00,Clara)
END_MAIN

//Label LocationBasedEvents
LocationBasedEvents:
House(0x11,House1,5,5)
House(0x12,House2,6,6)
END_MAIN

//Label MiscBasedEvents
MiscBasedEvents:
DefeatBoss(EndingScene)
CauseGameOverIfLordDies
END_MAIN

//Label TrapData
TrapData:
ENDTRAP
ALIGN 4

//Label Units
Units:
EndUnit

//Label BeginingScene
BeginningScene:
CAM1 [3,9]
// Leave 2 ends when Tact escapes, and escaped units start the next chapter hidden and undeployed,
// which LOAD3/LOAD2 skip. There's no prep screen here to redeploy them, so do it by hand.
REVEAL 0x00
SVAL 0x1 0x1 // SET_STATE with 1 clears the undeployed bit.
SET_STATE 0x00
CHECK_ALIVE Xena
BEQ 0x20 0x0 0xC
	REVEAL Xena
	SVAL 0x1 0x1
	SET_STATE Xena
LABEL 0x20
CHECK_ALIVE Zaheva
BEQ 0x21 0x0 0xC
	REVEAL Zaheva
	SVAL 0x1 0x1
	SET_STATE Zaheva
LABEL 0x21
CHECK_ALIVE Ajax
BEQ 0x22 0x0 0xC
	REVEAL Ajax
	SVAL 0x1 0x1
	SET_STATE Ajax
LABEL 0x22
LOAD3 0x1 PlayerLoading1
LOAD2 0x1 ChapterFriends
ENUN
// They also keep their escape marker, which hides them again once loaded. Reset them to plain, visible units.
SVAL 0x1 0x00
SVAL 0x2 0x0
ASMC SetUnitState|1 // Sets the whole state word to slot 0x2.
CHECK_ALIVE Xena
BEQ 0x23 0x0 0xC
	SVAL 0x1 Xena
	SVAL 0x2 0x0
	ASMC SetUnitState|1
LABEL 0x23
CHECK_ALIVE Zaheva
BEQ 0x24 0x0 0xC
	SVAL 0x1 Zaheva
	SVAL 0x2 0x0
	ASMC SetUnitState|1
LABEL 0x24
CHECK_ALIVE Ajax
BEQ 0x25 0x0 0xC
	SVAL 0x1 Ajax
	SVAL 0x2 0x0
	ASMC SetUnitState|1
LABEL 0x25
MUSC Rest_of_the_Heart
SetBackground(0x1D) // The forest road.
Text(Mage3LeaveStartingText)
EndConvo
STAL 0x10
LOAD1 0x1 Patrol
ENUN
STAL 0x10
CAM1 [16,7]
STAL 0x20
MUSC Darker
Text(Mage3LeaveLakshmiText)
STAL 0x10
CAM1 [3,9]
Text(Mage3LeaveObjectiveText)
STAL 0x10
MUSC Lights_in_the_Dark
NoFade
ENDA

//Label EndingScene
EndingScene:
FADI 0x5
CLEE 0x0
TurnAlly(Clara) // If she was never spoken to, she still travels with the party.
MUSC Anchoret
SetBackground(0x1F) // The forest at dusk.
Text(Mage3LeaveEndingText)
STAL 0x20
ASMC CallMage3LeaveMenu|1
STAL 0x20
BNE 0x0 0x0 0xC
	// Stand with Zaheva and face Clint's hunters.
	Text(Mage3LeaveChoseStandText)
	MoveToChapter(MageLeaveRevenge4)
	GOTO 0x1
LABEL 0x0
	// Keep running for Bacrun.
	Text(Mage3LeaveChoseRunText)
	MoveToChapter(MageLeaveRefuge4)
LABEL 0x1
NoFade
ENDA

//Label Turn events
ClaraArrives:
CAM1 [2,6]
LOAD1 0x1 ClaraUnit
ENUN
STAL 0x10
Text(Mage3LeaveClaraArrivesText)
NoFade
EndA2

Pursuers:
CAM1 [1,4]
LOAD1 0x1 PursuerUnits
ENUN
STAL 0x10
Text(Mage3LeavePursuersText)
NoFade
EndA2

Turn5:
CamON
LOAD1 0x1 Turn5Units
ENUN
CamOFF
NoFade
ENDA

//Label Character events
TXenaClara:
MUSI
Text(Mage3LeaveXenaClaraText)
MUNO
TurnAlly(Clara)
NoFade
EndA2

TTactClara:
MUSI
Text(Mage3LeaveTactClaraText)
MUNO
TurnAlly(Clara)
NoFade
ENDA

//Label Location events
House1:
MUSI
Text(0x00,Mage3LeaveHouse1Text)
GiveItem(Elixir,0xFFFF)
MUNO
NoFade
EndA2

House2:
MUSI
Text(0x00,Mage3LeaveHouse2Text)
GiveItem(Fire,0xFFFF)
MUNO
NoFade
ENDA

	/*UNIT DATA*/

