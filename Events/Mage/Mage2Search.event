ChapterEvents(Mage2SearchEvents,ThisChapter)

//Label ThisChapter
ThisChapter:
POIN TurnBasedEvents
POIN CharacterBasedEvents
POIN LocationBasedEvents
POIN MiscBasedEvents
POIN EndMainPointer EndMainPointer EndMainPointer
POIN EndMainPointer
POIN TrapData TrapData
POIN Units Units
POIN $0 $0 $0 $0 $0 $0
POIN BeginningScene EndingScene
//LabelEnd

//Label TurnBasedEvents
TurnBasedEvents:
TurnEventEnemy(0x0,Turn4,4)
TurnEventEnemy(0x0,Turn6,6)
END_MAIN

//Label CharacterBasedEvents
ALIGN 32
CharacterBasedEvents:
CharacterEventBothWays(0x10,TTactLakshmi,0x00,Lakshmi)
CharacterEventBothWays(0x11,TXenaLakshmi,Xena,Lakshmi)
END_MAIN

//Label LocationBasedEvents
LocationBasedEvents:
Seize(0x3,EndingScene,5,5)
Chest(Nosferatu,12,13)
Chest(Elixir,12,16)
END_MAIN

//Label MiscBasedEvents
MiscBasedEvents:
CauseGameOverIfLordDies
END_MAIN

//Label TrapData
TrapData:
ENDTRAP
ALIGN 4

//Label Units
Units:
EndUnit

//Label BeginingScene
BeginningScene:
CAM1 [5,13]
LOAD3 0x1 PlayerLoading1
LOAD2 0x1 ChapterFriends
LOAD1 0x1 BoundLakshmi
ENUN
MUSC Lights_in_the_Dark
SetBackground(0x33) // Temple gate.
Text(Mage2SearchStartingText)
MUSC Solve_the_Riddle
SetBackground(0x34) // Inside the ruin.
Text(Mage2SearchDescentText)
EndConvo
STAL 0x20
MOVE 0x00 0x00 [5,15]
ENUN
STAL 0x10
TEXTSTART
TEXTSHOW Mage2SearchSealText
TEXTEND
	// The sealed chamber at the top of the monument opens.
	FadeOutMusic
	CAM1 [5,4]
	STAL 0x20
	SOUN 0x00BD
	TileChange(5,4)
	STAL 0x40
	CAM1 [5,13]
	STAL 0x10
TEXTCONT
TEXTEND
	// The Guardians wake.
	MUSC Battle_against_Demons
	LOAD1 0x1 Guardians
	ENUN
	STAL 0x20
TEXTCONT
TEXTEND
REMA
STAL 0x10
MOVE 0x00 Xena [4,16]
ENUN
STAL 0x10
Text(Mage2SearchFreeLakshmiText)
TurnAlly(Lakshmi)
STAL 0x10
MUSC Seventh_Saga_Dungeon
NoFade
ENDA

//Label EndingScene
EndingScene:
FADI 0x5
CLEE 0x0
MUSC Lights_in_the_Dark
SetBackground(0x2E) // The inner sanctum.
Text(Mage2SearchPrismText)
FadeOutMusic
FADI 0x5
STAL 0x30
MUSC Legacy
SetBackground(0x35) // Darkness.
TEXTSTART
TEXTSHOW Mage2SearchVisionText
TEXTEND
MUSC The_Guardian_Spirit
TEXTCONT
TEXTEND
REMA
FadeOutMusic
FADI 0x5
STAL 0x40
MUSC Treasured_Memories
SetBackground(0x2E)
Text(Mage2SearchAfterVisionText)
MoveToChapter(MageSearch3)
NoFade
ENDA

//Label Turn events
Turn4:
CamON
LOAD1 0x1 Turn4Guardians
ENUN
CamOFF
NoFade
EndA2

Turn6:
CamON
LOAD1 0x1 Turn6Guardians
ENUN
CamOFF
NoFade
ENDA

//Label Character events
TTactLakshmi:
MUSI
Text(Mage2SearchTactLakshmiText)
MUNO
NoFade
EndA2

TXenaLakshmi:
MUSI
Text(Mage2SearchXenaLakshmiText)
MUNO
NoFade
ENDA

