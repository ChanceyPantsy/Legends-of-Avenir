ChapterEvents(Mage5LeaveRefugeMurielEvents,ThisChapter)

//Label ThisChapter
ThisChapter:
POIN TurnBasedEvents
POIN CharacterBasedEvents
POIN LocationBasedEvents
POIN MiscBasedEvents
POIN EndMainPointer EndMainPointer EndMainPointer
POIN EndMainPointer
POIN TrapData TrapData
POIN Units Units
POIN $0 $0 $0 $0 $0 $0
POIN BeginningScene EndingScene
//LabelEnd

//Label TurnBasedEvents
TurnBasedEvents:
TurnEventEnemy(0x0,Turn3,3)
TurnEventEnemy(0x0,Turn6,6)
END_MAIN

//Label CharacterBasedEvents
ALIGN 32
CharacterBasedEvents:
CharacterEvent(0x10,TClaraMuriel,Clara,Muriel)
CharacterEvent(0x11,TXenaMuriel,Xena,Muriel)
END_MAIN

//Label LocationBasedEvents
LocationBasedEvents:
House(0x12,Warehouse1,9,2)
House(0x13,Warehouse2,20,2)
House(0x14,Warehouse3,20,9)
House(0x15,Warehouse4,9,15)
Armory(ArmoryList,7,9)
Vendor(ShopList,19,14)
END_MAIN

//Label MiscBasedEvents
MiscBasedEvents:
DefeatBoss(EndingScene)
CauseGameOverIfLordDies
END_MAIN

//Label TrapData
TrapData:
ENDTRAP
ALIGN 4

