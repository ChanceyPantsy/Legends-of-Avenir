ChapterEvents(Mage5SearchArcanaeEvents,ThisChapter)

//Label ThisChapter
ThisChapter:
POIN TurnBasedEvents
POIN CharacterBasedEvents
POIN LocationBasedEvents
POIN MiscBasedEvents
POIN EndMainPointer EndMainPointer EndMainPointer
POIN EndMainPointer
POIN TrapData TrapData
POIN Units Units
POIN $0 $0 $0 $0 $0 $0
POIN BeginningScene EndingScene
//LabelEnd

//Label TurnBasedEvents
TurnBasedEvents:
TurnEventEnemy(0x0,Turn2,2)
TurnEventEnemy(0x0,Turn3,3)
TurnEventEnemy(0x0,Turn5,5)
TurnEventEnemy(0x0,Turn7,7)
TurnEventEnemy(0x0,Turn8,8)
TurnEventEnemy(0x0,EndingScene,10)
END_MAIN

//Label CharacterBasedEvents
ALIGN 32
CharacterBasedEvents:
CharacterEventBothWays(0x10,TZahevaAjax,Zaheva,Ajax)
CharacterEventBothWays(0x11,TKendrickXena,Kendrick,Xena)
END_MAIN

//Label LocationBasedEvents
LocationBasedEvents:
END_MAIN

//Label MiscBasedEvents
MiscBasedEvents:
DefeatBoss(EndingScene)
CauseGameOverIfLordDies
END_MAIN

//Label TrapData
TrapData:
ENDTRAP
ALIGN 4

//Label Units
Units:
UNIT PlayerMMage 0x00 0x00 Level(1,Ally,True) [12,12] 0x00 0x00 0x00 0x00 [0] NoAI
UNIT Xena 0x00 0x00 Level(1,Ally,True) [13,12] 0x00 0x00 0x00 0x00 [0] NoAI
UNIT Lakshmi 0x00 0x00 Level(1,Ally,True) [11,12] 0x00 0x00 0x00 0x00 [0] NoAI
UNIT Kendrick 0x00 0x00 Level(1,Ally,True) [14,12] 0x00 0x00 0x00 0x00 [0] NoAI
UNIT Zaheva 0x00 0x00 Level(1,Ally,True) [10,12] 0x00 0x00 0x00 0x00 [0] NoAI
UNIT Ajax 0x00 0x00 Level(1,Ally,True) [15,12] 0x00 0x00 0x00 0x00 [0] NoAI
EndUnit

//Label BeginingScene
BeginningScene:
CAM1 [13,8]
// Check before LOAD2: for anyone missing from the party it loads a stand-in that vanishes when the turn starts.
CHECK_ALIVE Zaheva
BNE 0x20 0x0 0xC
	LOAD1 0x1 ZahevaRejoins // She fell back in the village, and catches up here.
	ENUN
LABEL 0x20
CHECK_ALIVE Ajax
BNE 0x21 0x0 0xC
	LOAD1 0x1 AjaxRejoins // He fell back in the village, and catches up here.
	ENUN
LABEL 0x21
LOAD3 0x1 PlayerLoading1
LOAD2 0x1 ChapterFriends
LOAD1 0x1 CourtUnits
ENUN
MUSC Like_a_Glint_of_Light
SetBackground(0x0A) // Uzkalis' court.
Text(Mage5SearchArcanaeStartingText)
FadeOutMusic
FADI 0x5
STAL 0x20
MUSC Legacy
SetBackground(0x35)
Text(Mage5SearchArcanaeVisionText)
EndConvo
STAL 0x10
MUSC Emergency
Text(Mage5SearchArcanaeRaidText)
STAL 0x10
MOVE 0x00 Uzkalis [13,10]
MOVE 0x00 Shanley [18,10]
ENUN
DISA Uzkalis
DISA Shanley
STAL 0x10
LOAD1 0x1 LionBrigade
ENUN
CAM1 [20,3]
STAL 0x20
Text(Mage5SearchArcanaeBlaineText)
STAL 0x10
CAM1 [13,8]
Text(Mage5SearchArcanaeObjectiveText)
GotoPrepScreen

//Label EndingScene
EndingScene:
FADI 0x5
CLEE 0x0
MUSC Victory_March
SetBackground(0x0A)
Text(Mage5SearchArcanaeEndingText)
FadeOutMusic
FADI 0x5
STAL 0x30
MUSC Cataclysm
SetBackground(0x34) // The workshop beneath the compound.
Text(Mage5SearchArcanaeEngineText)
MoveToChapter(MageSearchArcanae6)
NoFade
ENDA

