ChapterEvents(Mage6LeaveRefugeMistlainEvents,ThisChapter)

//Label ThisChapter
ThisChapter:
POIN TurnBasedEvents
POIN CharacterBasedEvents
POIN LocationBasedEvents
POIN MiscBasedEvents
POIN EndMainPointer EndMainPointer EndMainPointer
POIN EndMainPointer
POIN TrapData TrapData
POIN Units Units
POIN $0 $0 $0 $0 $0 $0
POIN BeginningScene EndingScene
//LabelEnd

//Label TurnBasedEvents
TurnBasedEvents:
TurnEventEnemy(0x0,Turn4,4)
TurnEventEnemy(0x0,Turn6,6)
END_MAIN

//Label CharacterBasedEvents
ALIGN 32
CharacterBasedEvents:
CharacterEvent(0x10,TXenaMistlain,Xena,Mistlain)
END_MAIN

//Label LocationBasedEvents
LocationBasedEvents:
Door(8,8)
Door(10,6)
Chest(Bolganone,11,8)
Chest(Elixir,10,9)
END_MAIN

//Label MiscBasedEvents
MiscBasedEvents:
DefeatBoss(EndingScene)
CauseGameOverIfLordDies
END_MAIN

//Label TrapData
TrapData:
ENDTRAP
ALIGN 4

//Label Units
Units:
UNIT PlayerMMage 0x00 0x00 Level(1,Ally,True) [15,7] 0x00 0x00 0x00 0x00 [0] NoAI
UNIT Xena 0x00 0x00 Level(1,Ally,True) [14,7] 0x00 0x00 0x00 0x00 [0] NoAI
UNIT Zaheva 0x00 0x00 Level(1,Ally,True) [14,6] 0x00 0x00 0x00 0x00 [0] NoAI
UNIT Ajax 0x00 0x00 Level(1,Ally,True) [15,8] 0x00 0x00 0x00 0x00 [0] NoAI
UNIT Clara 0x00 0x00 Level(1,Ally,True) [14,8] 0x00 0x00 0x00 0x00 [0] NoAI
UNIT Kendrick 0x00 0x00 Level(1,Ally,True) [13,7] 0x00 0x00 0x00 0x00 [0] NoAI
EndUnit

//Label BeginingScene
BeginningScene:
MUSC Darker
SetBackground(0x0B) // The servants' stair of the Fire Tower.
Text(Mage6LeaveRefugeMistlainStartingText)
EndConvo
STAL 0x10
CAM1 [13,7]
LOAD3 0x1 PlayerLoading1
LOAD2 0x1 ChapterFriends
ENUN
LOAD1 0x1 MistlainUnit
LOAD1 0x1 TowerGuard
ENUN
STAL 0x10
CAM1 [4,4]
STAL 0x10
MUSC Tension
Text(Mage6LeaveRefugeMistlainLakshmiText)
STAL 0x10
CAM1 [10,8]
STAL 0x20
CAM1 [13,7]
Text(Mage6LeaveRefugeMistlainObjectiveText)
STAL 0x10
GotoPrepScreen

//Label EndingScene
EndingScene:
FADI 0x5
CLEE 0x0
TurnAlly(Mistlain) // He fights alongside the party on the way out of the city.
MUSC Anchoret
SetBackground(0x0E) // The old treasury.
Text(Mage6LeaveRefugeMistlainEndingText)
MoveToChapter(MageLeaveRefugeMistlain7)
NoFade
ENDA

//Label Turn events
Turn4:
CamON
LOAD1 0x1 Turn4Units
ENUN
CamOFF
NoFade
EndA2

Turn6:
CamON
LOAD1 0x1 Turn6Units
ENUN
CamOFF
NoFade
ENDA

//Label Character events
TXenaMistlain:
MUSI
Text(Mage6LeaveRefugeMistlainXenaMistlainText)
MUNO
NoFade
ENDA

