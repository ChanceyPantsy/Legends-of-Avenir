ChapterEvents(Mage7LeaveRefugeMurielEvents,ThisChapter)

//Label ThisChapter
ThisChapter:
POIN TurnBasedEvents
POIN CharacterBasedEvents
POIN LocationBasedEvents
POIN MiscBasedEvents
POIN EndMainPointer EndMainPointer EndMainPointer
POIN EndMainPointer
POIN TrapData TrapData
POIN Units Units
POIN $0 $0 $0 $0 $0 $0
POIN BeginningScene EndingScene
//LabelEnd

//Label TurnBasedEvents
TurnBasedEvents:
TurnEventEnemy(0x0,Turn3,3)
TurnEventEnemy(0x0,Turn5,5)
TurnEventEnemy(0x0,Turn7,7)
END_MAIN

//Label CharacterBasedEvents
ALIGN 32
CharacterBasedEvents:
CharacterEvent(0x10,TXenaLux,Xena,Lux)
END_MAIN

//Label LocationBasedEvents
LocationBasedEvents:
END_MAIN

//Label MiscBasedEvents
MiscBasedEvents:
DefeatBoss(EndingScene)
CauseGameOverIfLordDies
END_MAIN

//Label TrapData
TrapData:
ENDTRAP
ALIGN 4

//Label Units
Units:
UNIT PlayerMMage 0x00 0x00 Level(1,Ally,True) [8,26] 0x00 0x00 0x00 0x00 [0] NoAI
UNIT Xena 0x00 0x00 Level(1,Ally,True) [7,26] 0x00 0x00 0x00 0x00 [0] NoAI
UNIT Zaheva 0x00 0x00 Level(1,Ally,True) [9,26] 0x00 0x00 0x00 0x00 [0] NoAI
UNIT Ajax 0x00 0x00 Level(1,Ally,True) [8,27] 0x00 0x00 0x00 0x00 [0] NoAI
UNIT Clara 0x00 0x00 Level(1,Ally,True) [7,27] 0x00 0x00 0x00 0x00 [0] NoAI
UNIT Kendrick 0x00 0x00 Level(1,Ally,True) [9,27] 0x00 0x00 0x00 0x00 [0] NoAI
UNIT Lakshmi 0x00 0x00 Level(1,Ally,True) [6,26] 0x00 0x00 0x00 0x00 [0] NoAI
EndUnit

//Label BeginingScene
BeginningScene:
ENUT 0x12 // Prevents the good ending Tact death quote.
ENUT 0x13 // Prevents the bad ending Tact death quote.
CAM1 [8,24]
LOAD3 0x1 PlayerLoading1
LOAD2 0x1 ChapterFriends
LOAD1 0x1 Allies
ENUN
MUSC Rest_of_the_Heart
Text(Mage7LeaveRefugeMurielStartingText)
STAL 0x10
LOAD1 0x1 Legion
ENUN
CAM1 [16,17]
STAL 0x20
MUSC Dark_Clouds_Gather
Text(Mage7LeaveRefugeMurielXavusText)
STAL 0x10
CAM1 [8,24]
Text(Mage7LeaveRefugeMurielObjectiveText)
STAL 0x10
GotoPrepScreen

//Label EndingScene
EndingScene:
FADI 0x5
CLEA 0x0
CLEE 0x0
CLEN 0x0
ASMC RefreshAll|1
ASMC PrepForEnd|1
CHECK_EVENTID 0x14
BNE 0x0 0x0 0xC
	// Muriel lives, and proposes a new Council. Good ending.
	ENUF 0x12 // Enable Tact's good ending death quote.
	SVAL 0xB Coords(16,19)
	LOMA MageLeaveRefugeMuriel7
	LOAD3 0x1 EndingTact
	LOAD2 0x1 EndingFriends
	LOAD1 0x1 EndingMuriel
	ENUN
	MUSC Treasured_Memories
	FADU 0x5
	STAL 0x20
	Text(Mage7LeaveRefugeMurielGoodEndingText)
	STAL 0x10
	FadeOutMusic
	STAL 0x20
	MUSC The_Guardian_Spirit
	WarpIn(18,21,LoadNarrator)
	STAL 0x20
	Text(Mage7LeaveRefugeMurielGoodEndingNarratorText)
	STAL 0x08
	MOVE 0x00 Narrator [16,21]
	ENUN
	StartBattle
	NormalDamage(1,24)
	MissedAttack(0,0)
	CriticalHit(1,60)
	EndAttack
	SetBattleNumbers(21,8,0,91,24,20)
	FIG1 0x00 Narrator 0x00
	KillUnit(0x00)
	DISA 0x00
	GOTO 0x1
LABEL 0x0
	// Muriel fell. Bad ending.
	ENUF 0x13 // Enable Tact's bad ending death quote.
	SVAL 0xB Coords(16,19)
	LOMA MageLeaveRefugeMuriel7
	LOAD3 0x1 EndingTact
	LOAD2 0x1 EndingFriends
	ENUN
	MUSC All_Is_Lost
	FADU 0x5
	STAL 0x20
	Text(Mage7LeaveRefugeMurielBadEndingText)
	STAL 0x10
	FadeOutMusic
	STAL 0x20
	MUSC The_Guardian_Spirit
	WarpIn(18,21,LoadNarrator)
	STAL 0x20
	Text(Mage7LeaveRefugeMurielBadEndingNarratorText)
	STAL 0x08
	MOVE 0x00 Narrator [16,21]
	ENUN
	StartBattle
	NormalDamage(1,30)
	NormalDamage(1,30)
	EndAttack
	SetBattleNumbers(21,8,0,87,30,18)
	FIG1 0x00 Narrator 0x00
	KillUnit(0x00)
	DISA 0x00
	STAL 0x20
LABEL 0x1
ENUT 0xDB // This life ended in the Mage route's Wind ending. (True ending tracker.)
CALL MageRouteCleanup
MoveToChapter(PrologueChapter)
ENDA

//Label Turn events
Turn3:
CamON
LOAD1 0x1 Turn3Units
ENUN
CamOFF
Text(Mage7LeaveRefugeMurielGuardiansText)
NoFade
EndA2

Turn5:
CamON
LOAD1 0x1 Turn5Units
ENUN
CamOFF
NoFade
EndA2

Turn7:
CamON
LOAD1 0x1 Turn7Units
ENUN
CamOFF
NoFade
ENDA

//Label Character events
TXenaLux:
MUSI
Text(Mage7LeaveRefugeMurielXenaLuxText)
MUNO
NoFade
ENDA

