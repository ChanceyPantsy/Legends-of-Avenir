ChapterEvents(Mage4SearchEvents,ThisChapter)

//Label ThisChapter
ThisChapter:
POIN TurnBasedEvents
POIN CharacterBasedEvents
POIN LocationBasedEvents
POIN MiscBasedEvents
POIN EndMainPointer EndMainPointer EndMainPointer
POIN EndMainPointer
POIN TrapData TrapData
POIN Units Units
POIN $0 $0 $0 $0 $0 $0
POIN BeginningScene EndingScene
//LabelEnd

//Label TurnBasedEvents
TurnBasedEvents:
TurnEventEnemy(0x0,Turn3,3)
TurnEventEnemy(0x0,Turn5,5)
END_MAIN

//Label CharacterBasedEvents
ALIGN 32
CharacterBasedEvents:
CharacterEvent(0x10,TXenaAjax,Xena,Ajax)
CharacterEvent(0x10,TTactAjax,0x00,Ajax)
CharacterEvent(0x11,TTactZaheva,0x00,Zaheva)
CharacterEvent(0x11,TXenaZaheva,Xena,Zaheva)
END_MAIN

//Label LocationBasedEvents
LocationBasedEvents:
Vendor(ShopList,11,2)
House(0x12,WestHouse,3,1)
House(0x13,SouthHouse,6,10)
House(0x14,EastHouse,13,12)
END_MAIN

//Label MiscBasedEvents
MiscBasedEvents:
DefeatBoss(EndingScene)
CauseGameOverIfLordDies
END_MAIN

//Label TrapData
TrapData:
ENDTRAP
ALIGN 4

//Label Units
Units:
UNIT PlayerMMage 0x00 0x00 Level(1,Ally,True) [6,7] 0x00 0x00 0x00 0x00 [0] NoAI
UNIT Xena 0x00 0x00 Level(1,Ally,True) [5,7] 0x00 0x00 0x00 0x00 [0] NoAI
UNIT Lakshmi 0x00 0x00 Level(1,Ally,True) [6,8] 0x00 0x00 0x00 0x00 [0] NoAI
UNIT Kendrick 0x00 0x00 Level(1,Ally,True) [4,7] 0x00 0x00 0x00 0x00 [0] NoAI
EndUnit

//Label BeginingScene
BeginningScene:
CAM1 [6,6]
// Check before LOAD2: for anyone missing from the party it loads a stand-in that vanishes when the turn starts.
CHECK_ALIVE Kendrick
BNE 0x20 0x0 0xC
	LOAD1 0x1 KendrickRejoins // He fell back in the desert, and catches up here.
	ENUN
LABEL 0x20
LOAD3 0x1 PlayerLoading1
LOAD2 0x1 ChapterFriends
ENUN
MUSC Town_of_Winds_and_Ruins
SetBackground(0x05) // The crossroads outpost.
Text(Mage4SearchStartingText)
MUSC Rest_of_the_Heart
SetBackground(0x09) // The inn.
Text(Mage4SearchInnText)
EndConvo
STAL 0x10
MUSC Tension
LOAD1 0x1 ShanleyCutscene
ENUN
CAM1 [8,3]
STAL 0x20
TEXTSTART
TEXTSHOW Mage4SearchStandoffText
TEXTEND
	// Mistlain's guards arrive from the south road.
	CAM1 [6,13]
	LOAD1 0x1 MistlainGuards
	ENUN
	STAL 0x10
TEXTCONT
TEXTEND
	// Sean steps forward.
	CAM1 [8,3]
	STAL 0x10
TEXTCONT
TEXTEND
	// Sean takes his men across the square.
	MUSC Emergency
	MOVE 0x00 Sean [17,9]
	ENUN
	LOAD1 0x1 SeanSquad
	ENUN
	CAM1 [8,3]
	STAL 0x10
TEXTCONT
TEXTEND
REMA
STAL 0x10
MOVE 0x00 Shanley [8,0]
ENUN
DISA Shanley
STAL 0x20
CAM1 [6,6]
Text(Mage4SearchAfterStandoffText)
STAL 0x10
GotoPrepScreen

//Label EndingScene
EndingScene:
FADI 0x5
CLEE 0x0
// They stay with the party whichever road is chosen. If either fell back, they rejoin in the next chapter.
CHECK_ALIVE Zaheva
BEQ 0x20 0x0 0xC // Changing a unit that is not on the map would hang the event.
	TurnAlly(Zaheva)
LABEL 0x20
CHECK_ALIVE Ajax
BEQ 0x21 0x0 0xC // Changing a unit that is not on the map would hang the event.
	TurnAlly(Ajax)
LABEL 0x21
MUSC Rest_of_the_Heart
SetBackground(0x05)
Text(Mage4SearchEndingText)
STAL 0x20
ASMC CallMage4SearchMenu|1
STAL 0x20
BNE 0x0 0x0 0xC
	// Go with Lakshmi to Uzkalis.
	Text(Mage4SearchChoseLakshmiText)
	MoveToChapter(MageSearchArcanae5)
	GOTO 0x1
LABEL 0x0
	// Seek out Efil. Lakshmi leaves with Shanley.
	TEXTSTART
	TEXTSHOW Mage4SearchChoseEfilText
	TEXTEND
	DISA Lakshmi
	TEXTCONT
	TEXTEND
	REMA
	MoveToChapter(MageSearchEfil5)
LABEL 0x1
NoFade
ENDA

//Label Turn events
Turn3:
CamON
LOAD1 0x1 Turn3Units
ENUN
CamOFF
NoFade
EndA2

Turn5:
CamON
LOAD1 0x1 Turn5Units
ENUN
CamOFF
NoFade
ENDA

