ChapterEvents(Mage6LeaveRefugeMurielEvents,ThisChapter)

//Label ThisChapter
ThisChapter:
POIN TurnBasedEvents
POIN CharacterBasedEvents
POIN LocationBasedEvents
POIN MiscBasedEvents
POIN EndMainPointer EndMainPointer EndMainPointer
POIN EndMainPointer
POIN TrapData TrapData
POIN Units Units
POIN $0 $0 $0 $0 $0 $0
POIN BeginningScene EndingScene
//LabelEnd

//Label TurnBasedEvents
TurnBasedEvents:
TurnEventEnemy(0x0,Wave2,2)
TurnEventEnemy(0x0,Wave4,4)
TurnEventEnemy(0x0,Wave6,6)
TurnEventEnemy(0x0,Wave8,8)
TurnEventEnemy(0x0,Wave10,10)
TurnEventEnemy(0x0,EndingScene,11) // Hold the harbor for eleven turns.
END_MAIN

//Label CharacterBasedEvents
ALIGN 32
CharacterBasedEvents:
CharacterEvent(0x13,TXenaLakshmi,Xena,Lakshmi)
CharacterEvent(0x14,TTactLakshmi,0x00,Lakshmi)
END_MAIN

//Label LocationBasedEvents
LocationBasedEvents:
House(0x10,House1,8,2)
House(0x11,House2,15,9)
House(0x12,House3,12,12)
Armory(ArmoryList,16,12)
Vendor(ShopList,16,15)
END_MAIN

//Label MiscBasedEvents
MiscBasedEvents:
CauseGameOverIfLordDies
END_MAIN

//Label TrapData
TrapData:
ENDTRAP
ALIGN 4

