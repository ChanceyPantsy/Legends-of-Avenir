ChapterEvents(Mage7SearchEfilEvents,ThisChapter)

//Label ThisChapter
ThisChapter:
POIN TurnBasedEvents
POIN CharacterBasedEvents
POIN LocationBasedEvents
POIN MiscBasedEvents
POIN EndMainPointer EndMainPointer EndMainPointer
POIN EndMainPointer
POIN TrapData TrapData
POIN Units Units
POIN $0 $0 $0 $0 $0 $0
POIN BeginningScene EndingScene
//LabelEnd

//Label TurnBasedEvents
TurnBasedEvents:
TurnEventPlayer(0x0,LakshmiArrives,4)
TurnEventEnemy(0x0,Turn6,6)
TurnEventEnemy(0x0,Turn8,8)
END_MAIN

//Label CharacterBasedEvents
ALIGN 32
CharacterBasedEvents:
CharacterEvent(0x10,TXenaEfil,Xena,Efil)
CharacterEvent(0x15,TXenaLakshmi,Xena,Lakshmi) // Bringing Lakshmi back gives the good ending, as long as she survives.
CharacterEvent(0x15,TTactLakshmi,0x00,Lakshmi)
END_MAIN

//Label LocationBasedEvents
LocationBasedEvents:
Chest(Aura,17,0)
Chest(SilverBlade,17,3)
Armory(ArmoryList,17,23)
Vendor(ShopList,18,24)
END_MAIN

//Label MiscBasedEvents
MiscBasedEvents:
DefeatBoss(EndingScene)
CauseGameOverIfLordDies
END_MAIN

//Label TrapData
TrapData:
ENDTRAP
ALIGN 4

//Label Units
Units:
UNIT PlayerMMage 0x00 0x00 Level(1,Ally,True) [11,2] 0x00 0x00 0x00 0x00 [0] NoAI
UNIT Xena 0x00 0x00 Level(1,Ally,True) [10,2] 0x00 0x00 0x00 0x00 [0] NoAI
UNIT Efil 0x00 0x00 Level(1,Ally,True) [11,1] 0x00 0x00 0x00 0x00 [0] NoAI
UNIT Kendrick 0x00 0x00 Level(1,Ally,True) [12,2] 0x00 0x00 0x00 0x00 [0] NoAI
UNIT Zaheva 0x00 0x00 Level(1,Ally,True) [10,4] 0x00 0x00 0x00 0x00 [0] NoAI
UNIT Ajax 0x00 0x00 Level(1,Ally,True) [12,4] 0x00 0x00 0x00 0x00 [0] NoAI
EndUnit

//Label BeginingScene
BeginningScene:
ENUT 0x12 // Prevents the good ending Tact death quote.
ENUT 0x13 // Prevents the bad ending Tact death quote.
CAM1 [11,3]
LOAD3 0x1 PlayerLoading1
LOAD2 0x1 ChapterFriends
ENUN
MUSC Anchoret
Text(Mage7SearchEfilStartingText)
STAL 0x10
FadeOutMusic
CAM1 [14,21]
STAL 0x10
LOAD1 0x1 MistlainArrives // His guard marches in through the main hall.
ENUN
STAL 0x10
MUSC Dark_Clouds_Gather
Text(Mage7SearchEfilMistlainText)
STAL 0x10
CAM1 [11,3]
MUSC Tension
Text(Mage7SearchEfilObjectiveText)
GotoPrepScreen

//Label EndingScene
EndingScene:
FADI 0x5
CLEA 0x0
CLEE 0x0
CLEN 0x0
ASMC RefreshAll|1
ASMC PrepForEnd|1
CHECK_EVENTID 0x15
BEQ 0x0 0x0 0xC
CHECK_EVENTID 0x14
BNE 0x0 0x0 0xC
	// Lakshmi came back to her teacher, and lived. Good ending.
	ENUF 0x12 // Enable Tact's good ending death quote.
	SVAL 0xB Coords(11,3)
	LOMA MageSearchEfil7
	LOAD3 0x1 EndingTact
	LOAD2 0x1 EndingFriendsGood
	ENUN
	MUSC Treasured_Memories
	FADU 0x5
	STAL 0x20
	Text(Mage7SearchEfilGoodEndingText)
	GOTO 0x1
LABEL 0x0
	// Lakshmi stayed on the other side, or fell. Bad ending.
	ENUF 0x13 // Enable Tact's bad ending death quote.
	SVAL 0xB Coords(11,3)
	LOMA MageSearchEfil7
	LOAD3 0x1 EndingTact
	LOAD2 0x1 EndingFriends
	ENUN
	MUSC A_Tragic_Decision
	FADU 0x5
	STAL 0x20
	Text(Mage7SearchEfilBadEndingText)
LABEL 0x1
STAL 0x10
FadeOutMusic
FlashWhite // The Light swallows the sanctum.
MUSC Aquatic_Dystopia
SetBackground(0x35)
Text(Mage7SearchEfilMemoryText)
EndConvo
STAL 0x10
MUSC The_Guardian_Spirit
WarpIn(11,1,LoadNarrator)
STAL 0x20
Text(Mage7SearchEfilNarratorText)
STAL 0x08
MOVE 0x00 Narrator [11,2]
ENUN
CHECK_EVENTID 0x12 // Still set only on the bad ending.
BNE 0x2 0x0 0xC
	StartBattle
	NormalDamage(1,24)
	MissedAttack(0,0)
	CriticalHit(1,60)
	EndAttack
	SetBattleNumbers(21,8,0,91,24,20)
	FIG1 0x00 Narrator 0x00
	GOTO 0x3
LABEL 0x2
	StartBattle
	NormalDamage(1,30)
	NormalDamage(1,30)
	EndAttack
	SetBattleNumbers(21,8,0,87,30,18)
	FIG1 0x00 Narrator 0x00
LABEL 0x3
KillUnit(0x00)
DISA 0x00
STAL 0x20
WarpOut(11,2,Narrator)
STAL 0x30
Text(Mage7SearchEfilAfterText)
STAL 0x20
ENUT 0xDD // This life ended in the Mage route's Light ending. (True ending tracker.)
CALL MageRouteCleanup
MoveToChapter(PrologueChapter)
ENDA

//Label Turn events
LakshmiArrives:
CAM1 [2,2]
LOAD1 0x1 LakshmiSquad // Uzkalis told her about the Sateenkaari's hidden stair.
ENUN
STAL 0x10
MUSC Darker
TEXTSTART
TEXTSHOW Mage7SearchEfilLakshmiArrivesText
TEXTEND
	CAM1 [14,21] // Mistlain's guard holds the main hall.
	STAL 0x30
	CAM1 [2,2]
	STAL 0x10
TEXTCONT
TEXTEND
REMA
NoFade
EndA2

Turn6:
CamON
LOAD1 0x1 Turn6Units
ENUN
CamOFF
NoFade
EndA2

Turn8:
CamON
LOAD1 0x1 Turn8Units
ENUN
CamOFF
NoFade
ENDA

//Label Character events
TXenaEfil:
MUSI
Text(Mage7SearchEfilXenaEfilText)
MUNO
NoFade
EndA2

TXenaLakshmi:
MUSI
Text(Mage7SearchEfilXenaLakshmiText)
MUNO
TurnAlly(Lakshmi)
NoFade
EndA2

TTactLakshmi:
MUSI
Text(Mage7SearchEfilTactLakshmiText)
MUNO
TurnAlly(Lakshmi)
NoFade
ENDA

//Label Shops
ArmoryList:
SHLI SteelSword SteelBlade KillingEdge SteelLance SteelAxe SteelBow
ALIGN 4

ShopList:
SHLI Elfire Elwind Elthunder Flux Luna Lightning Shine Mend Physic Vulnerary Elixir
ALIGN 4
