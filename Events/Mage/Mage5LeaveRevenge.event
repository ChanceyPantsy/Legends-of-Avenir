ChapterEvents(Mage5LeaveRevengeEvents,ThisChapter)

//Label ThisChapter
ThisChapter:
POIN TurnBasedEvents
POIN CharacterBasedEvents
POIN LocationBasedEvents
POIN MiscBasedEvents
POIN EndMainPointer EndMainPointer EndMainPointer
POIN EndMainPointer
POIN TrapData TrapData
POIN Units Units
POIN $0 $0 $0 $0 $0 $0
POIN BeginningScene EndingScene
//LabelEnd

//Label TurnBasedEvents
TurnBasedEvents:
TurnEventEnemy(0x0,Turn4,4)
TurnEventEnemy(0x0,Turn7,7)
END_MAIN

//Label CharacterBasedEvents
ALIGN 32
CharacterBasedEvents:
CharacterEvent(0x16,TZahevaVal,Zaheva,Val) // Only works once the records are found.
CharacterEvent(0x16,TXenaVal,Xena,Val)
END_MAIN

//Label LocationBasedEvents
LocationBasedEvents:
LOCA 0x3 EndingScene [3,1] 0x19 // "Arrive" (EscapeArrive hack): any unit can end the chapter here. Vanilla Seize only works for the lord character IDs 0x01/0x0F, which is not every Tact.
DOOR 0x11 [8,4] 0x12
DOOR 0x12 [14,4] 0x12
House(0x15,ClintRecords,11,1) // Clint's notes on his subjects.
Chest(Nosferatu,9,1)
Chest(Elixir,13,1)
Chest(Shine,15,1)
Chest(MasterSeal,8,2)
Chest(KillingEdge,14,2)
END_MAIN

//Label MiscBasedEvents
MiscBasedEvents:
AFEV 0x13 OpenLibrary 0x11
AFEV 0x13 OpenLibrary 0x12
CauseGameOverIfLordDies
END_MAIN

//Label TrapData
TrapData:
ENDTRAP
ALIGN 4

//Label Units
Units:
UNIT PlayerMMage 0x00 0x00 Level(1,Ally,True) [8,20] 0x00 0x00 0x00 0x00 [0] NoAI
UNIT Xena 0x00 0x00 Level(1,Ally,True) [7,20] 0x00 0x00 0x00 0x00 [0] NoAI
UNIT Zaheva 0x00 0x00 Level(1,Ally,True) [9,20] 0x00 0x00 0x00 0x00 [0] NoAI
UNIT Ajax 0x00 0x00 Level(1,Ally,True) [8,19] 0x00 0x00 0x00 0x00 [0] NoAI
UNIT Clara 0x00 0x00 Level(1,Ally,True) [8,21] 0x00 0x00 0x00 0x00 [0] NoAI
EndUnit

//Label BeginingScene
BeginningScene:
CAM1 [8,18]
LOAD3 0x1 PlayerLoading1
LOAD2 0x1 ChapterFriends
LOAD1 0x1 Prisoners
ENUN
MUSC Darker
SetBackground(0x0B) // The manor cellar at night.
Text(Mage5LeaveRevengeStartingText)
EndConvo
STAL 0x10
LOAD1 0x1 HouseGuard
ENUN
STAL 0x10
MUSC Tension
Text(Mage5LeaveRevengeGuardsText)
STAL 0x10
CAM1 [3,2]
STAL 0x20
CAM1 [8,18]
Text(Mage5LeaveRevengeObjectiveText)
STAL 0x10
GotoPrepScreen

//Label EndingScene
EndingScene:
FADI 0x5
CLEE 0x0
MUSC Anchoret
SetBackground(0x0E) // Clint's study.
Text(Mage5LeaveRevengeEndingText)
CHECK_EVENTID 0x17
BEQ 0x0 0x0 0xC
	Text(Mage5LeaveRevengeEndingValText)
	GOTO 0x1
LABEL 0x0
	Text(Mage5LeaveRevengeEndingNoValText)
	DISA Val
	DISA Helmer
LABEL 0x1
MoveToChapter(MageLeaveRevenge6)
NoFade
ENDA

//Label Turn events
Turn4:
CamON
LOAD1 0x1 Turn4Units
ENUN
CamOFF
NoFade
EndA2

Turn7:
CamON
LOAD1 0x1 Turn7Units
ENUN
CamOFF
NoFade
ENDA

//Label Misc events
OpenLibrary:
TILECHANGE 0 // The library's iron doors are open.
CamON
LOAD1 0x1 LibraryGuards
ENUN
CamOFF
NoFade
ENDA

//Label Location events
ClintRecords:
MUSI
Text(Mage5LeaveRevengeRecordsText)
MUNO
NoFade
ENDA

//Label Character events
TZahevaVal:
CHECK_EVENTID 0x15
BEQ 0x0 0x0 0xC
	MUSI
	Text(Mage5LeaveRevengeZahevaValText)
	MUNO
	TurnAlly(Val)
	CHECK_ALIVE Helmer
	BEQ 0x20 0x0 0xC // Changing a unit that is not on the map would hang the event.
		TurnAlly(Helmer)
	LABEL 0x20
	ENUT 0x17 // Val and Helmer joined.
	GOTO 0x1
LABEL 0x0
	Text(Mage5LeaveRevengeNotYetText)
	ENUF 0x16 // Let them talk again once the records are found.
LABEL 0x1
NoFade
EndA2

TXenaVal:
CHECK_EVENTID 0x15
BEQ 0x0 0x0 0xC
	MUSI
	Text(Mage5LeaveRevengeXenaValText)
	MUNO
	TurnAlly(Val)
	CHECK_ALIVE Helmer
	BEQ 0x20 0x0 0xC // Changing a unit that is not on the map would hang the event.
		TurnAlly(Helmer)
	LABEL 0x20
	ENUT 0x17
	GOTO 0x1
LABEL 0x0
	Text(Mage5LeaveRevengeNotYetText)
	ENUF 0x16
LABEL 0x1
NoFade
ENDA

