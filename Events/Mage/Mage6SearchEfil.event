//Label BeginingScene
BeginningScene:
MUSC Lights_in_the_Dark
SVAL 0xB Coords(7,4)
LOMA OutsideKilthelCutscene
LOAD3 0x1 PlayerLoadingOutside
LOAD2 0x1 OutsideFriends
ENUN
Text(Mage6SearchEfilOutsideText)
FADI 0x5
EnterStop
CLEA 0x0
SVAL 0xB Coords(7,5)
LOMA ArtifactDoorCutscene
LOAD3 0x1 PlayerLoadingDoor
LOAD2 0x1 DoorFriends
ENUN
FADU 0x5
MUSC LyonTheme
STAL 0x20
TileChange(7,4) // A path rises out of the water toward the hollow in the wall.
SOUN 0x00F7
STAL 0x40
MOVE 0x00 0x00 [7,3]
ENUN
STAL 0x10
Text(Mage6SearchEfilSlotText)
TileChange(5,0) // The Prism fits. The wall slides open.
SOUN 0x00F7
STAL 0x30
FadeOutMusic
Text(Mage6SearchEfilWallOpensText)
STAL 0x10
FADI 0x5
EnterStop
CLEA 0x0
SVAL 0xB Coords(7,14)
LOMA MageSearchEfil6
LOAD3 0x1 PlayerLoading1
LOAD2 0x1 ChapterFriends
LOAD1 0x1 StartingGuardians
ENUN
STAL 0x30
FADU 0x5
MUSC Tension
STAL 0x20
Text(Mage6SearchEfilGuardiansText)
STAL 0x10
NoFade
GotoPrepScreen

//Label EndingScene
EndingScene:
FADI 0x5
CLEE 0x0
TurnAlly(Efil) // Efil travels with the party from here on.
MUSC Anchoret
SetBackground(0x2E) // The temple's inner halls.
Text(Mage6SearchEfilEndingText)
MoveToChapter(MageSearchEfil7)
NoFade
ENDA

