ChapterEvents(Mage6SearchEfilEvents,ThisChapter)

//Label ThisChapter
ThisChapter:
POIN TurnBasedEvents
POIN CharacterBasedEvents
POIN LocationBasedEvents
POIN MiscBasedEvents
POIN EndMainPointer EndMainPointer EndMainPointer
POIN EndMainPointer
POIN TrapData TrapData
POIN Units Units
POIN $0 $0 $0 $0 $0 $0
POIN BeginningScene EndingScene
//LabelEnd

//Label TurnBasedEvents
TurnBasedEvents:
TurnEventPlayer(0x0,EfilArrives,2)
TurnEventEnemy(0x0,DanielArrives,3)
TurnEventEnemy(0x0,Turn5,5)
TurnEventEnemy(0x0,Turn7,7)
END_MAIN

//Label CharacterBasedEvents
ALIGN 32
CharacterBasedEvents:
CharacterEvent(0x10,TTactEfil,0x00,Efil)
CharacterEvent(0x10,TKendrickEfil,Kendrick,Efil)
END_MAIN

//Label LocationBasedEvents
LocationBasedEvents:
Chest(Elixir,8,15)
Chest(Luna,9,15)
Chest(SilverSword,13,15)
Chest(Shine,14,14)
Chest(MasterSeal,19,6)
Chest(Speedwings,20,6)
END_MAIN

//Label MiscBasedEvents
MiscBasedEvents:
DefeatBoss(EndingScene)
CauseGameOverIfLordDies
END_MAIN

//Label TrapData
TrapData:
ENDTRAP
ALIGN 4

//Label Units
