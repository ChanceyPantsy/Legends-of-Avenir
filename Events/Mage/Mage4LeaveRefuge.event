ChapterEvents(Mage4LeaveRefugeEvents,ThisChapter)

//Label ThisChapter
ThisChapter:
POIN TurnBasedEvents
POIN CharacterBasedEvents
POIN LocationBasedEvents
POIN MiscBasedEvents
POIN EndMainPointer EndMainPointer EndMainPointer
POIN EndMainPointer
POIN TrapData TrapData
POIN Units Units
POIN $0 $0 $0 $0 $0 $0
POIN BeginningScene EndingScene
//LabelEnd

//Label TurnBasedEvents
TurnBasedEvents:
TurnEventEnemy(0x0,Turn3,3)
TurnEventEnemy(0x0,Turn6,6)
END_MAIN

//Label CharacterBasedEvents
ALIGN 32
CharacterBasedEvents:
CharacterEvent(0x10,TXenaKendrick,Xena,Kendrick)
CharacterEvent(0x10,TTactKendrick,0x00,Kendrick)
CharacterEvent(0x10,TClaraKendrick,Clara,Kendrick)
END_MAIN

//Label LocationBasedEvents
LocationBasedEvents:
House(0x11,House1,4,2)
House(0x12,House2,19,2)
House(0x13,House3,16,9)
House(0x14,House4,4,14)
Vendor(ShopList,14,2)
Armory(ArmoryList,3,9)
Armory(ArmoryList2,14,14)
Vendor(ShopList2,19,14)
END_MAIN

//Label MiscBasedEvents
MiscBasedEvents:
DefeatBoss(EndingScene)
CauseGameOverIfLordDies
END_MAIN

//Label TrapData
TrapData:
ENDTRAP
ALIGN 4

//Label Units
Units:
UNIT PlayerMMage 0x00 0x00 Level(1,Ally,True) [1,5] 0x00 0x00 0x00 0x00 [0] NoAI
UNIT Xena 0x00 0x00 Level(1,Ally,True) [0,5] 0x00 0x00 0x00 0x00 [0] NoAI
UNIT Zaheva 0x00 0x00 Level(1,Ally,True) [1,6] 0x00 0x00 0x00 0x00 [0] NoAI
UNIT Ajax 0x00 0x00 Level(1,Ally,True) [0,6] 0x00 0x00 0x00 0x00 [0] NoAI
UNIT Clara 0x00 0x00 Level(1,Ally,True) [2,6] 0x00 0x00 0x00 0x00 [0] NoAI
EndUnit

//Label BeginingScene
BeginningScene:
MUSC Town_of_Winds_and_Ruins
SetBackground(0x05) // The market streets of Bacrun.
Text(Mage4LeaveRefugeStartingText)
EndConvo
STAL 0x10
CAM1 [2,5]
LOAD3 0x1 PlayerLoading1
LOAD2 0x1 ChapterFriends
ENUN
LOAD1 0x1 KendrickUnit
LOAD1 0x1 Hunters
ENUN
STAL 0x10
CAM1 [18,5]
STAL 0x10
MUSC Tension
Text(Mage4LeaveRefugeMasonText)
STAL 0x10
CAM1 [12,3]
STAL 0x10
Text(Mage4LeaveRefugeKendrickText)
STAL 0x10
CAM1 [2,5]
Text(Mage4LeaveRefugeObjectiveText)
STAL 0x10
GotoPrepScreen

//Label EndingScene
EndingScene:
FADI 0x5
CLEE 0x0
TurnAlly(Kendrick) // If no one spoke to him, he still brings the passports.
MUSC Rest_of_the_Heart
SetBackground(0x09) // A quiet inn.
Text(Mage4LeaveRefugeEndingText)
STAL 0x20
ASMC CallMage4LeaveRefugeMenu|1
STAL 0x20
BNE 0x0 0x0 0xC
	// Accept Muriel's offer.
	Text(Mage4LeaveRefugeChoseMurielText)
	MoveToChapter(MageLeaveRefugeMuriel5)
	GOTO 0x1
LABEL 0x0
	// Go back for Mistlain.
	Text(Mage4LeaveRefugeChoseMistlainText)
	MoveToChapter(MageLeaveRefugeMistlain5)
LABEL 0x1
NoFade
ENDA

