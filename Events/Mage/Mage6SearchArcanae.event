ChapterEvents(Mage6SearchArcanaeEvents,ThisChapter)

//Label ThisChapter
ThisChapter:
POIN TurnBasedEvents
POIN CharacterBasedEvents
POIN LocationBasedEvents
POIN MiscBasedEvents
POIN EndMainPointer EndMainPointer EndMainPointer
POIN EndMainPointer
POIN TrapData TrapData
POIN Units Units
POIN $0 $0 $0 $0 $0 $0
POIN BeginningScene EndingScene
//LabelEnd

//Label TurnBasedEvents
TurnBasedEvents:
TurnEventPlayer(0x0,ShanleyArrives,3)
TurnEventEnemy(0x0,Turn4,4)
TurnEventEnemy(0x0,Turn6,6)
END_MAIN

//Label CharacterBasedEvents
ALIGN 32
CharacterBasedEvents:
CharacterEvent(0x10,TLakshmiShanley,Lakshmi,Shanley)
CharacterEvent(0x11,TXenaAlexis,Xena,Alexis)
CharacterEvent(0x12,TLakshmiAlexis,Lakshmi,Alexis)
END_MAIN

//Label LocationBasedEvents
LocationBasedEvents:
House(0x13,NorthHouse,7,11)
House(0x14,MiddleHouse,6,17)
House(0x15,SWHouse,2,21)
END_MAIN

//Label MiscBasedEvents
MiscBasedEvents:
DefeatBoss(EndingScene)
CauseGameOverIfLordDies
END_MAIN

//Label TrapData
TrapData:
ENDTRAP
ALIGN 4

//Label Units
Units:
UNIT PlayerMMage 0x00 0x00 Level(1,Ally,True) [3,18] 0x00 0x00 0x00 0x00 [0] NoAI
UNIT Xena 0x00 0x00 Level(1,Ally,True) [4,18] 0x00 0x00 0x00 0x00 [0] NoAI
UNIT Lakshmi 0x00 0x00 Level(1,Ally,True) [2,18] 0x00 0x00 0x00 0x00 [0] NoAI
UNIT Kendrick 0x00 0x00 Level(1,Ally,True) [5,19] 0x00 0x00 0x00 0x00 [0] NoAI
UNIT Zaheva 0x00 0x00 Level(1,Ally,True) [3,19] 0x00 0x00 0x00 0x00 [0] NoAI
UNIT Ajax 0x00 0x00 Level(1,Ally,True) [4,19] 0x00 0x00 0x00 0x00 [0] NoAI
EndUnit

//Label BeginingScene
BeginningScene:
CAM1 [5,15]
LOAD3 0x1 PlayerLoading1
LOAD2 0x1 ChapterFriends
LOAD1 0x1 Clinic
ENUN
TILECHANGE 7 // The south house and the southeast house have already been emptied.
TILECHANGE 9
MUSC Town_of_Winds_and_Ruins
SetBackground(0x05) // The Outer Ring.
Text(Mage6SearchArcanaeStartingText)
EndConvo
STAL 0x10
LOAD1 0x1 GeraldSquad
ENUN
CAM1 [9,5]
STAL 0x20
MUSC Darker
TEXTSTART
TEXTSHOW Mage6SearchArcanaeGeraldText
TEXTEND
	MUSC Emergency
	STAL 0x10
TEXTCONT
TEXTEND
REMA
STAL 0x10
CAM1 [5,15]
Text(Mage6SearchArcanaeObjectiveText)
GotoPrepScreen

//Label EndingScene
EndingScene:
FADI 0x5
CLEE 0x0
CHECK_ALIVE Shanley
BEQ 0x20 0x0 0xC // He fell back; he catches up with the party in the next chapter.
	TurnAlly(Shanley)
LABEL 0x20
MUSC A_Tragic_Decision
SetBackground(0x05)
TEXTSTART
TEXTSHOW Mage6SearchArcanaeEndingText
TEXTEND
	STAL 0x30
TEXTCONT
TEXTEND
REMA
MoveToChapter(MageSearchArcanae7)
NoFade
ENDA

//Label Turn events
ShanleyArrives:
CAM1 [9,2]
LOAD1 0x1 ShanleyUnit
ENUN
STAL 0x10
Text(Mage6SearchArcanaeShanleyArrivesText)
NoFade
EndA2

