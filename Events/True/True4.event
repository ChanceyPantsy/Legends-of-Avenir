ChapterEvents(True4Events,ThisChapter)

//Label ThisChapter
ThisChapter:
POIN TurnBasedEvents
POIN CharacterBasedEvents
POIN LocationBasedEvents
POIN MiscBasedEvents
POIN EndMainPointer EndMainPointer EndMainPointer
POIN EndMainPointer
POIN TrapData TrapData
POIN Units Units
POIN $0 $0 $0 $0 $0 $0
POIN BeginningScene EndingScene
//LabelEnd

//Label TurnBasedEvents
TurnBasedEvents:
TurnEventEnemy(0x0,Turn2,2)
TurnEventEnemy(0x0,Turn4,4)
TurnEventEnemy(0x0,Turn6,6)
END_MAIN

//Label CharacterBasedEvents
ALIGN 32
CharacterBasedEvents:
END_MAIN

//Label LocationBasedEvents
LocationBasedEvents:
END_MAIN

//Label MiscBasedEvents
MiscBasedEvents:
DefeatBoss(EndingScene)
CauseGameOverIfLordDies
END_MAIN

//Label TrapData
TrapData:
ENDTRAP
ALIGN 4

//Label Units
Units:
UNIT PlayerMMage 0x00 0x00 Level(1,Ally,True) [10,12] 0x00 0x00 0x00 0x00 [0] NoAI
UNIT Arc 0x00 0x00 Level(1,Ally,True) [6,12] 0x00 0x00 0x00 0x00 [0] NoAI
UNIT Luke 0x00 0x00 Level(1,Ally,True) [7,13] 0x00 0x00 0x00 0x00 [0] NoAI
UNIT Vicar 0x00 0x00 Level(1,Ally,True) [5,13] 0x00 0x00 0x00 0x00 [0] NoAI
UNIT Walter 0x00 0x00 Level(1,Ally,True) [6,13] 0x00 0x00 0x00 0x00 [0] NoAI
UNIT Baret 0x00 0x00 Level(1,Ally,True) [7,12] 0x00 0x00 0x00 0x00 [0] NoAI
UNIT Jasper 0x00 0x00 Level(1,Ally,True) [13,12] 0x00 0x00 0x00 0x00 [0] NoAI
UNIT Derek 0x00 0x00 Level(1,Ally,True) [14,13] 0x00 0x00 0x00 0x00 [0] NoAI
UNIT Yvette 0x00 0x00 Level(1,Ally,True) [15,13] 0x00 0x00 0x00 0x00 [0] NoAI
UNIT Xena 0x00 0x00 Level(1,Ally,True) [9,12] 0x00 0x00 0x00 0x00 [0] NoAI
UNIT Zaheva 0x00 0x00 Level(1,Ally,True) [11,12] 0x00 0x00 0x00 0x00 [0] NoAI
UNIT Ajax 0x00 0x00 Level(1,Ally,True) [9,13] 0x00 0x00 0x00 0x00 [0] NoAI
UNIT Lakshmi 0x00 0x00 Level(1,Ally,True) [11,13] 0x00 0x00 0x00 0x00 [0] NoAI
UNIT Efil 0x00 0x00 Level(1,Ally,True) [10,11] 0x00 0x00 0x00 0x00 [0] NoAI
EndUnit

//Label BeginingScene
BeginningScene:
CAM1 [10,8]
LOAD3 0x1 PlayerLoading1
LOAD2 0x1 AllEchoes
LOAD1 0x1 GuardianSpiritUnit
ENUN
MUSC The_Guardian_Spirit
Text(True4StartingText)
STAL 0x10
WarpIn(10,11,EfilEcho) // The Light lets Efil through.
STAL 0x10
MUSC Inanimate_Dream
Text(True4EfilText)
STAL 0x10
LOAD1 0x1 Phantoms
ENUN
STAL 0x10
Text(True4ObjectiveText)
STAL 0x10
GotoPrepScreen

//Label EndingScene
EndingScene:
FADI 0x5
CLEA 0x0
CLEE 0x0
CLEN 0x0
ASMC RefreshAll|1
ASMC PrepForEnd|1
SVAL 0xB Coords(10,8)
LOMA True4
LOAD3 0x1 EndingTact
LOAD2 0x1 EndingFriends
LOAD1 0x1 EndingToivo
ENUN
MUSC Treasured_Memories
FADU 0x5
STAL 0x20
Text(True4EndingText)
STAL 0x20
ASMC CallTrue4Menu|1
STAL 0x20
SVAL 0x1 0x1
SVAL 0x2 0x2
BNE 0x0 0x0 0xC
	// Return to Haedric.
	SetBackground(0x1B)
	Text(True4HaedricEpilogueText)
	GOTO 0x3
LABEL 0x0
BNE 0x1 0x1 0xC
	// Return to Cesaria.
	SetBackground(0x26)
	Text(True4CesariaEpilogueText)
	GOTO 0x3
LABEL 0x1
	// Return to Arcanae.
	SetBackground(0x0E)
	Text(True4ArcanaeEpilogueText)
LABEL 0x3
STAL 0x20
SetBackground(0x35)
Text(True4TheEndText)
STAL 0x40
ENUT 0xDF // The cycle is broken. (The Prologue remembers this.)
ENUF 0x67
ENUF 0x68
ENUF 0x69
ENUF 0x6A
ENUF 0x6B
ENUF 0x6C
ENUF 0x6D
ENUF 0x6E
ENUF 0xA0
DISA Arc
DISA Luke
DISA Vicar
DISA Walter
DISA Baret
DISA Jasper
DISA Derek
DISA Yvette
DISA Xena
DISA Zaheva
DISA Ajax
DISA Lakshmi
DISA Efil
DISA 0x00
MoveToChapter(PrologueChapter)
ENDA

//Label Turn events
Turn2:
CamON
LOAD1 0x1 Turn2Units
ENUN
CamOFF
Text(True4PhantomsText)
NoFade
EndA2

Turn4:
CamON
LOAD1 0x1 Turn4Units
ENUN
CamOFF
NoFade
EndA2

Turn6:
CamON
LOAD1 0x1 Turn6Units
ENUN
CamOFF
NoFade
ENDA

