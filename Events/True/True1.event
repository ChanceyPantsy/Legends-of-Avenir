ChapterEvents(True1Events,ThisChapter)

//Label ThisChapter
ThisChapter:
POIN TurnBasedEvents
POIN CharacterBasedEvents
POIN LocationBasedEvents
POIN MiscBasedEvents
POIN EndMainPointer EndMainPointer EndMainPointer
POIN EndMainPointer
POIN TrapData TrapData
POIN Units Units
POIN $0 $0 $0 $0 $0 $0
POIN BeginningScene EndingScene
//LabelEnd

//Label TurnBasedEvents
TurnBasedEvents:
TurnEventEnemy(0x0,Turn3,3)
TurnEventEnemy(0x0,Turn5,5)
END_MAIN

//Label CharacterBasedEvents
ALIGN 32
CharacterBasedEvents:
END_MAIN

//Label LocationBasedEvents
LocationBasedEvents:
END_MAIN

//Label MiscBasedEvents
MiscBasedEvents:
DefeatBoss(EndingScene)
CauseGameOverIfLordDies
END_MAIN

//Label TrapData
TrapData:
ENDTRAP
ALIGN 4

//Label Units
Units:
EndUnit

//Label BeginingScene
BeginningScene:
CAM1 [12,12]
LOAD3 0x1 PlayerLoading1
ENUN
MUSC The_Guardian_Spirit
SetBackground(0x35) // The realm between lives.
Text(True1StartingText)
EndConvo
STAL 0x20
MUSC Treasured_Memories
WarpIn(12,12,HaedricEchoes) // Echoes of every Haedrician friend Tact ever made.
STAL 0x10
Text(True1EchoesText)
STAL 0x10
LOAD1 0x1 HenningEchoes
ENUN
CAM1 [9,2]
STAL 0x10
MUSC Darker
Text(True1BanditsText)
STAL 0x10
CAM1 [12,12]
Text(True1ObjectiveText)
STAL 0x10
MUSC Fields_of_Avenir
NoFade
ENDA

//Label EndingScene
EndingScene:
FADI 0x5
CLEE 0x0
MUSC Treasured_Memories
SetBackground(0x1B) // The fields of Haedric, fading.
Text(True1EndingText)
MoveToChapter(True2)
NoFade
ENDA

//Label Turn events
Turn3:
CamON
LOAD1 0x1 Turn3Units
ENUN
CamOFF
NoFade
EndA2

Turn5:
CamON
LOAD1 0x1 Turn5Units
ENUN
CamOFF
NoFade
ENDA

