UNIT Yvette 0x00 0x00 Level(1,Ally,True) [1,12] 0x00 0x00 0x00 0x00 [0] NoAI
EndUnit

//Label BeginingScene
BeginningScene:
CAM1 [2,9]
LOAD3 0x1 PlayerLoading1
ENUN
MUSC The_Guardian_Spirit
SetBackground(0x35) // The realm between lives.
Text(True2StartingText)
EndConvo
STAL 0x20
MUSC Treasured_Memories
WarpIn(3,9,CesariaEchoes)
STAL 0x10
Text(True2EchoesText)
STAL 0x10
LOAD1 0x1 FortressEchoes
ENUN
CAM1 [12,7]
STAL 0x10
MUSC Darker
Text(True2DunlasText)
STAL 0x10
CAM1 [2,9]
Text(True2ObjectiveText)
STAL 0x10
GotoPrepScreen

//Label EndingScene
EndingScene:
FADI 0x5
CLEE 0x0
MUSC Treasured_Memories
SetBackground(0x26) // The training fortress, fading.
Text(True2EndingText)
MoveToChapter(True3)
NoFade
ENDA

//Label Turn events
Turn3:
CamON
LOAD1 0x1 Turn3Units
ENUN
CamOFF
NoFade
ENDA

