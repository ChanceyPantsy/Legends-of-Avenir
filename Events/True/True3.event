//Label BeginingScene
BeginningScene:
CAM1 [4,3]
LOAD3 0x1 PlayerLoading1
ENUN
MUSC The_Guardian_Spirit
SetBackground(0x35) // The realm between lives.
Text(True3StartingText)
EndConvo
STAL 0x20
MUSC Treasured_Memories
WarpIn(4,3,ArcanaeEchoes)
STAL 0x10
Text(True3EchoesText)
STAL 0x10
LOAD1 0x1 RuinEchoes
ENUN
CAM1 [12,12]
STAL 0x10
MUSC Darker
Text(True3KilthelText)
STAL 0x10
CAM1 [4,3]
Text(True3ObjectiveText)
STAL 0x10
GotoPrepScreen

//Label EndingScene
EndingScene:
FADI 0x5
CLEE 0x0
MUSC Treasured_Memories
SetBackground(0x34) // The ruin, fading.
Text(True3EndingText)
MoveToChapter(True4)
NoFade
ENDA

//Label Turn events
Turn3:
CamON
LOAD1 0x1 Turn3Units
ENUN
CamOFF
NoFade
EndA2

Turn5:
CamON
LOAD1 0x1 Turn5Units
ENUN
CamOFF
NoFade
ENDA

